# -------------------------------------------------------------
# GoWord Academy - Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# -------------------------------------------------------------

# Google Gemini AI API Key (Tutor & Question Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Deepgram API Key (Real-time Speech-to-Text for conversation exercises)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Session & Security
SESSION_SECRET=your_random_32_character_secret_key_here

# Firebase Client Configuration (Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin SDK Configuration (Server-Side)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Note: For private keys with newlines, keep \n escaped or as multi-line string
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
